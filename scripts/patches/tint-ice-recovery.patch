 namespace tint {
 
+/// Host-armed recovery point for Tint internal compiler errors. Tint is built
+/// -fno-exceptions and its ICE handler normally traps the whole (wasm) module.
+/// When this points at a setjmp buffer, the ICE destructor longjmps there
+/// instead, so a single bad shader fails gracefully rather than aborting the
+/// render. Set/cleared by the host around a Tint call; nullptr = default trap.
+extern std::jmp_buf* internal_compiler_error_recovery;
+
