--- a/src/tint/utils/ice/ice.cc
+++ b/src/tint/utils/ice/ice.cc
@@ -36,6 +36,9 @@
 
 namespace tint {
 
+// Host-armed recovery point for ICEs (see ice.h). Default: trap as before.
+std::jmp_buf* internal_compiler_error_recovery = nullptr;
+
 InternalCompilerError::InternalCompilerError(const char* file,
                                              size_t line,
                                              InternalCompilerErrorCallback callback)
@@ -63,6 +66,14 @@ InternalCompilerError::~InternalCompilerError() {
         std::cerr << err.str();
     }
 
+    // If the host armed a recovery point, longjmp out instead of trapping so a
+    // single unsupported shader fails gracefully rather than killing the module.
+    if (internal_compiler_error_recovery) {
+        std::jmp_buf* target = internal_compiler_error_recovery;
+        internal_compiler_error_recovery = nullptr;
+        std::longjmp(*target, 1);
+    }
+
     debugger::Break();
 
