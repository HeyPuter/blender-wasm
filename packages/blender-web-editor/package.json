{
  "name": "@knervous/blender-web-editor",
  "version": "0.0.2",
  "description": "An editor HUD on @knervous/blender-web: mounts over a Babylon.js, Babylon Lite or three.js scene and drives Blender (WebAssembly) from it, with a swap to the full Blender UI.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knervous/blender-wasm.git",
    "directory": "packages/blender-web-editor"
  },
  "keywords": [
    "blender",
    "editor",
    "babylonjs",
    "babylon-lite",
    "threejs",
    "webassembly"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./babylon": {
      "types": "./dist/babylon.d.ts",
      "default": "./dist/babylon.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "default": "./dist/lite.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "default": "./dist/three.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@knervous/blender-web": "~0.0.4"
  },
  "peerDependencies": {
    "@babylonjs/core": ">=8",
    "@babylonjs/lite": ">=1.33.0",
    "three": ">=0.160"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": {
      "optional": true
    },
    "@babylonjs/lite": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjs/core": "^9.31.0",
    "@babylonjs/lite": "1.36.0",
    "@knervous/blender-web": "file:../blender-web",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3"
  }
}
