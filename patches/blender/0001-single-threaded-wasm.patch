 {
   for (ThreadSlot &tslot : *threadbase) {
     if (tslot.avail) {
+#ifdef BLI_THREADS_INLINE
+      /* The task runs to completion here and the slot stays available, so the remove, clear
+       * and end calls below find nothing to join. */
+      tslot.callerdata = callerdata;
+      tslot_thread_start(&tslot);
+      tslot.callerdata = nullptr;
+#else
       tslot.avail = 0;
       tslot.callerdata = callerdata;
