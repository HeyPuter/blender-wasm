# ---------------------------------------------------------------------------
# blender-wasm .gitignore
# Everything reproducible from `make` / the build scripts is untracked.
# Tracked = the orchestration: Makefile, scripts/, cmake/, smoke/, web/*.html,
# web/*.mjs, node-webgpu/*.cjs, package.json, README.md, this file.
# (The WebGPU backend + WASM patches live in the fork, pulled by `make blender`.)
# NOTE: gitignore has NO inline comments — keep `#` lines separate from patterns.
# ---------------------------------------------------------------------------

# toolchain / sources / dep trees (regenerated by make)
/emsdk/
/blender/
/deps/
/wasm-sysroot/

# CMake / ninja build dirs
/build-blender/
/build-cycles/

# npm
/node_modules/
/package-lock.json
/node-webgpu/node_modules/
/node-webgpu/package-lock.json

# node + Dawn + lavapipe harness: generated module + logs + captures
/node-webgpu/blender_node.js
/node-webgpu/blender_node.wasm
/node-webgpu/blender_node.data
/node-webgpu/blender_node.js.symbols
/node-webgpu/blender_full.log
/node-webgpu/*.log
/node-webgpu/*.ppm
/node-webgpu/eevee_node_capture.*

# web build outputs (regenerated)
/web/blender.js
/web/blender.wasm
/web/blender.data
/web/blender.js.symbols
/web/blender_sh.js
/web/blender_sh.wasm
/web/blender_sh.js.symbols
/web/blender-thumbnailer.js
/web/blender-thumbnailer.wasm
/web/blender_assets/
/web/cycles.js
/web/cycles.wasm
/web/cycles.data
/web/smoke.js
/web/smoke.wasm
/web/wgpu_compute.js
/web/wgpu_compute.wasm
/web/wgpu_triangle.js
/web/wgpu_triangle.wasm
/web/eevee_capture.png
/web/webgpu-shot.png
/web/verify-shot.png

# misc
*.o
*.a
/scratchpad/
.DS_Store
