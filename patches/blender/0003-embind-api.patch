+/** \file
+ * \ingroup creator
+ *
+ * The JavaScript API of the headless WebAssembly builds (embind), for hosts
+ * that drive Blender directly rather than through Python scripts:
+ *
+ *   bwGet(path)            an RNA value as JSON, `path` in bpy.data syntax
+ *                          (`objects["Cube"].location`)
+ *   bwSet(path, value)     sets it (number, boolean, string, enum identifier,
+ *                          or an array of numbers) and runs RNA's update
+ *   bwCall(op, props)      runs an operator by idname, props as an object
+ *   bwPython(code)         runs a Python statement (scripts still go here)
+ *   bwObjects()            every object as JSON: bw_id, name, type, parent
+ *   bwMesh(idOrName)       an object's evaluated mesh, in the shape of the
+ *                          project's MeshData (glTF space, unindexed, grouped
+ *                          by material); its arrays view wasm memory until the
+ *                          next bwMesh call
+ *
+ * Every call runs on Blender's thread between requests: the server's poll
+ * loop (creator.cc, BLENDER_WASM_POLL) attaches the context and, in the
+ * pthread build, drains calls proxied here from the worker's thread. In the
+ * single-threaded build the worker only runs while that loop is suspended,
+ * so calls run directly. Values cross threads as plain C++ data; JS values
+ * are made on the calling thread (they are per thread).
+ */
+
+#if defined(__EMSCRIPTEN__) && defined(WITH_HEADLESS)
+
+#  include <algorithm>
+#  include <cstdio>
+#  include <functional>
+#  include <string>
+#  include <variant>
