{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": false,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
