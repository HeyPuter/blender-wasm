+#    include <pthread.h>
+#  endif
+
+#  include "BLI_listbase_iterator.hh"
+#  include "BLI_math_vector_types.hh"
+#  include "BLI_span.hh"
+#  include "BLI_string.hh"
+#  include "BLI_utildefines.hh"
+
+#  include "BKE_attribute.hh"
+#  include "BKE_context.hh"
+#  include "BKE_global.hh"
+#  include "BKE_idprop.hh"
+#  include "BKE_main.hh"
+#  include "BKE_mesh.hh"
